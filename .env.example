# ── Circles environment ───────────────────────────────────────────
# Copy this file to ".env" and fill in the values.
# Get CLIENT_ID and CLIENT_SECRET from https://developer.spotify.com/dashboard
# (create an app, then add the redirect URI below to the app's settings).

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/auth/callback

# Any long random string — signs the login cookie.
SESSION_SECRET=change_me_to_a_long_random_string

PORT=8888
